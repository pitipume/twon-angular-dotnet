{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=twon_dev;Username=twon;Password=twon_password"
  },
  "MongoDB": {
    "ConnectionString": "mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net",
    "DatabaseName": "twon"
  },
  "Redis": {
    "ConnectionString": "rediss://default:<password>@<host>.upstash.io:6380"
  },
  "R2": {
    "AccountUrl": "https://<account-id>.r2.cloudflarestorage.com",
    "BucketName": "twon",
    "AccessKeyId": "<r2-access-key-id>",
    "SecretAccessKey": "<r2-secret-access-key>"
  },
  "Resend": {
    "ApiKey": "re_<your-resend-api-key>"
  },
  "JWT_SECRET": "<set-via-env-var-or-user-secrets>"
}
